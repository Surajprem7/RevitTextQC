<Window x:Class="RevitTextQC.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text QC Settings" Width="720" Height="690" MinWidth="620" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="List" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="Import..." Width="80" Click="OnImport" Margin="0,0,6,0"
                    ToolTip="Load settings from a file, for example the office standard." />
            <Button Content="Export..." Width="80" Click="OnExport"
                    ToolTip="Save these settings to a file to share with the team." />
            <Button DockPanel.Dock="Right" Content="Cancel" Width="80" IsCancel="True" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="OK" Width="80" IsDefault="True" Click="OnOk" />
        </DockPanel>

        <TabControl>
            <TabItem Header="What to scan">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ScanTextNotes" Content="Text notes and 3D model text" />
                    <CheckBox x:Name="ScanDimensions" Content="Dimension text, including spot elevations (prefix, suffix, above, below, override)" />
                    <CheckBox x:Name="ScanTags" Content="Tags, including room, area and space tags (displayed text)" />
                    <CheckBox x:Name="ScanSheetsAndViews" Content="Sheet numbers, sheet names, view names, grid and level names" />
                    <CheckBox x:Name="ScanSchedules" Content="Schedules (titles and column headings)" />
                    <CheckBox x:Name="ScanScheduleBody" Content="Also check schedule cell values (slower)" Margin="20,3,0,3" />
                    <CheckBox x:Name="ScanKeynotes" Content="Keynote text (entire-project scans only)" />
                    <CheckBox x:Name="KeynotesUsedOnly" Content="Only keynotes assigned to types or materials in this model" Margin="20,3,0,3" />
                    <CheckBox x:Name="ScanTitleBlock" Content="Title block fields and revision text (sheet and project information)" Margin="0,10,0,3" />
                    <CheckBox x:Name="ScanTitleBlockText" Content="Fixed text typed inside the title block (briefly exports each sheet; slower)"
                              ToolTip="Revit does not expose the words typed inside a title block family. Each sheet is exported to a temporary file, the title block's text is read from it, and the file is deleted." />
                    <CheckBox x:Name="ScanVisibleText" Content="Text drawn by families and symbols inside views (slower)"
                              ToolTip="Reads every word Revit draws in the views, including labels inside annotation families and symbols. Fixed text inside a title block cannot be read by Revit." />
                    <CheckBox x:Name="ScanParameters" Content="Room, space and area names, plus these text parameters:" Margin="0,10,0,3" />
                    <TextBlock Style="{StaticResource Hint}" Text="One parameter name per line, for example Comments or Description." Margin="20,0,0,4" />
                    <TextBox x:Name="ParameterNames" Style="{StaticResource List}" Height="56" Margin="20,0,0,0" />

                    <TextBlock x:Name="InventoryTitle" Text="Text in the active view / sheet" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock x:Name="InventoryHint" Style="{StaticResource Hint}"
                               Text="Every kind of annotation in the view you have open, and whether Text QC reads it." />
                    <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4"
                              Height="110" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind of annotation" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="Elements" Binding="{Binding Count, Mode=OneWay}" Width="70" />
                            <DataGridTextColumn Header="Text QC" Binding="{Binding Status, Mode=OneWay}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Spelling">
                <DockPanel Margin="12">
                    <CheckBox DockPanel.Dock="Top" x:Name="CheckSpelling" Content="Check spelling" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,2,0,2"
                               Text="Pick the language the client expects: United Kingdom suits most UAE and Saudi clients, Australia suits Australian clients (it also treats 'programme' as a mistake), United States suits American ones. The choice is remembered for each project, so moving between your Dubai, Saudi and Australian projects needs no changes. A new project starts with the language you chose last. In United Kingdom and Australia modes, common American construction words such as 'elevator' and 'sidewalk' are accepted; American spellings such as 'color' or 'center' are reported." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="Spelling language:" VerticalAlignment="Center" Width="150" />
                        <ComboBox x:Name="LanguageBox" Width="220" DisplayMemberPath="Label" SelectedValuePath="Code" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Ignore words shorter than:" VerticalAlignment="Center" Width="150" />
                        <TextBox x:Name="MinWordLength" Width="40" />
                        <TextBlock Text=" letters" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Custom words (one per line): project names, product names and abbreviations the dictionary does not know. Codes containing digits, such as M12 or 100mm, are always ignored." />
                    <TextBox x:Name="CustomWords" Style="{StaticResource List}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Text type &amp; size">
                <DockPanel Margin="12">
                    <CheckBox DockPanel.Dock="Top" x:Name="CheckTextStyles" Content="Check text and dimension types against the approved standards" />
                    <CheckBox DockPanel.Dock="Top" x:Name="FlagInlineFormatting" Content="Flag text notes with manual bold, italic or underline formatting" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="One entry per line. An empty list means anything is allowed. Type names accept * and ? wildcards. Sizes are in millimetres." />
                    <UniformGrid Columns="2" x:Name="StandardsHost" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Case &amp; wording">
                <DockPanel Margin="12">
                    <CheckBox DockPanel.Dock="Top" x:Name="CheckCase" Content="Check letter case" />
                    <Grid DockPanel.Dock="Top" Margin="20,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Text notes" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TextNoteCase" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Dimension text" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DimensionCase" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Sheet names" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SheetNameCase" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="View names" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ViewNameCase" Margin="0,2" />
                        <TextBlock Grid.Row="4" Text="Parameters" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ParameterCase" Margin="0,2" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="20,0,0,2"
                               Text="Never change the case of (one per line). Anything containing a digit, such as 100mm or M12, is always left alone." />
                    <TextBox DockPanel.Dock="Top" x:Name="CaseExceptions" Style="{StaticResource List}" Height="52" Margin="20,0,0,8" />
                    <CheckBox DockPanel.Dock="Top" x:Name="CheckWhitespace" Content="Check spacing (double spaces, spaces at the ends, space before punctuation, empty notes)" />
                    <CheckBox DockPanel.Dock="Top" x:Name="CheckForbiddenTerms" Content="Check for forbidden words and phrases:" Margin="0,10,0,3" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="One per line. Add the preferred wording after =&gt; to offer it as a fix, for example:  approx =&gt; approximately" />
                    <TextBox x:Name="ForbiddenTerms" Style="{StaticResource List}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Naming">
                <StackPanel Margin="12">
                    <CheckBox x:Name="CheckNaming" Content="Check sheet and view naming" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Regular expressions. The whole number or name must match. Leave a pattern empty to skip that check. Example sheet number pattern:  [A-Z]{1,2}-\d{3}" />
                    <TextBlock Text="Sheet number pattern" Margin="0,6,0,2" />
                    <TextBox x:Name="SheetNumberPattern" FontFamily="Consolas" />
                    <TextBlock Text="Sheet name pattern" Margin="0,8,0,2" />
                    <TextBox x:Name="SheetNamePattern" FontFamily="Consolas" />
                    <TextBlock Text="View name pattern" Margin="0,8,0,2" />
                    <TextBox x:Name="ViewNamePattern" FontFamily="Consolas" />
                    <CheckBox x:Name="FlagDefaultViewNames" Margin="0,12,0,0"
                              Content="Flag default and copied names (&quot;Section 3&quot;, &quot;Level 1 Copy 1&quot;, &quot;Unnamed&quot;)" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Updates">
                <StackPanel Margin="12">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoCheckUpdates" Content="Check GitHub for a new version when Revit starts" />
                    <CheckBox x:Name="AutoInstallUpdates" Content="Download new versions automatically and install them when Revit closes" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Updates are downloaded from the project's GitHub releases. With automatic install switched off you are only told that a new version exists." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
