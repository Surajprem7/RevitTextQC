<Window x:Class="RevitTextQC.UI.ViewPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose views and sheets" Width="560" Height="580" MinWidth="420" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Search by name" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}"
                           Text="Tick the views and sheets to scan. A sheet includes the views placed on it and its title block." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button Content="Tick shown" Click="OnTickShown" Margin="0,0,8,0" />
                <Button Content="Clear" Click="OnClear" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource MutedText}" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="84" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Click="OnOk" Width="84" Style="{StaticResource PrimaryButton}" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="ChoicesGrid" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnRowChecked" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="KIND" Binding="{Binding Kind, Mode=OneWay}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
