<Window x:Class="RevitTextQC.UI.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text QC" Width="1120" Height="800" MinWidth="820" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
    <DockPanel>

        <!-- Scan bar, shared by both tabs -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="False">
                <ComboBox x:Name="ScopeBox" Width="180" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="OnScopeChanged">
                    <ComboBoxItem Content="Active view / sheet" />
                    <ComboBoxItem Content="Selected views / sheets" />
                </ComboBox>
                <Button x:Name="ChooseButton" Content="Choose..." Click="OnChooseViews" IsEnabled="False" Margin="0,0,8,0"
                        ToolTip="Tick the views and sheets to scan." />
                <TextBlock x:Name="ChosenText" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource MutedText}" />
                <Button x:Name="ScanButton" Content="Scan" Click="OnScan" Style="{StaticResource PrimaryButton}" />
                <CheckBox x:Name="HighlightBox" Content="Highlight in Revit when I click a row" IsChecked="True"
                          VerticalAlignment="Center" Margin="18,0,0,0"
                          ToolTip="Selects the element in Revit as soon as you click it here. Text on the open sheet is highlighted without leaving the sheet." />
                <Button DockPanel.Dock="Right" Content="Settings" Click="OnSettings" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Text="Ready." />
        </Border>

        <TabControl x:Name="Tabs">

            <!-- ============ QC findings ============ -->
            <TabItem Header="QC findings">
                <DockPanel Margin="16,12,16,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <ComboBox x:Name="RuleBox" Width="170" Margin="0,0,8,0" SelectionChanged="OnFilterChanged"
                                  ToolTip="Show one rule only" />
                        <TextBox x:Name="SearchBox" Width="200" Margin="0,0,8,0" TextChanged="OnFilterChanged"
                                 ToolTip="Search the findings" />
                        <TextBlock Text="Group by" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource MutedText}" />
                        <ComboBox x:Name="GroupByBox" Width="130" SelectedIndex="3" SelectionChanged="OnGroupByChanged">
                            <ComboBoxItem Content="Nothing" />
                            <ComboBoxItem Content="Rule" />
                            <ComboBoxItem Content="View / sheet" />
                            <ComboBoxItem Content="Found in" />
                            <ComboBoxItem Content="Level" />
                            <ComboBoxItem Content="Word / term" />
                        </ComboBox>
                        <Button DockPanel.Dock="Right" Content="Export CSV" Click="OnExport" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Margin="0,0,0,2" FontSize="14" FontWeight="SemiBold"
                               Text="Press Scan to check the model." />
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource MutedText}"
                               Text="Click a row to highlight it in Revit. Press Show, or double-click the row, to open its view and zoom to it." />

                    <!-- Details of the selected finding -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DetailMessage" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                                       FontWeight="SemiBold" Text="Select a finding to see the details." />

                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock DockPanel.Dock="Top" Text="Corrected text (edit before applying if needed)" Margin="0,0,0,4"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="FixBox" Height="44" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsEnabled="False" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Width="230">
                                <TextBlock Text="Spelling suggestions" Margin="0,0,0,4" Style="{StaticResource MutedText}" />
                                <ComboBox x:Name="AlternativesBox" IsEnabled="False" SelectionChanged="OnAlternativeChosen" />
                                <Button x:Name="AddWordButton" Content="Add word to dictionary" Click="OnAddWord"
                                        Margin="0,8,0,0" IsEnabled="False" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ShowButton" Content="Show in Revit" Click="OnShow" IsEnabled="False" Margin="0,0,8,0"
                                        ToolTip="Opens the view the element is in and zooms to it." />
                                <Button x:Name="ApplyButton" Content="Apply fix" Click="OnApply" IsEnabled="False" Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="FixSelectedButton" Content="Fix all selected" Click="OnFixSelected" IsEnabled="False"
                                        ToolTip="Applies the first suggestion to every selected finding that has one." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="IssuesGrid" SelectionMode="Extended"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Expander IsExpanded="True">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='   {0} finding(s)'}"
                                                                               Foreground="{DynamicResource Muted}" />
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <ItemsPresenter />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <!-- Fixed widths only: with a stretch column the grid squeezes every other column. -->
                                <DataGridTextColumn Header="ERROR IN THE TEXT" Binding="{Binding Problem, Mode=OneWay}" Width="150" />
                                <DataGridTextColumn Header="SUGGESTION" Binding="{Binding Suggestion, Mode=OneWay}" Width="150" />
                                <DataGridTextColumn Header="ELEMENT ID" Binding="{Binding ElementId, Mode=OneWay}" Width="90" />
                                <DataGridTemplateColumn Header="" Width="70" MinWidth="70" MaxWidth="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Show" Click="OnRowShowClick" Padding="10,0" MinHeight="24" Margin="0"
                                                    Style="{StaticResource LinkButton}"
                                                    ToolTip="Open the view this text is in and zoom to it" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RULE" Binding="{Binding Rule, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="FULL TEXT" Binding="{Binding Text, Mode=OneWay}" Width="230" />
                                <DataGridTextColumn Header="FINDING" Binding="{Binding Message, Mode=OneWay}" Width="300" />
                                <DataGridTextColumn Header="FOUND IN" Binding="{Binding Source, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="WHERE" Binding="{Binding Location, Mode=OneWay}" Width="260" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Shown in place of the list before a scan, while scanning, and when nothing was found -->
                    <Border x:Name="EmptyState" Background="{DynamicResource Bg}" CornerRadius="8" Margin="1" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <Ellipse x:Name="EmptyBadge" Width="44" Height="44" Fill="{DynamicResource AccentSoft}" Margin="0,0,0,12" />
                            <TextBlock x:Name="EmptyTitle" Text="Ready to scan" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,4,0,0"
                                       Text="Choose a scope and press Scan. Findings will be listed here." />
                        </StackPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ Find text by type / size / font / style ============ -->
            <TabItem Header="Find text">
                <DockPanel Margin="16,12,16,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="Find by" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedText}" />
                        <ComboBox x:Name="FindByBox" Width="150" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="OnFindOptionsChanged">
                            <ComboBoxItem Content="Text type" />
                            <ComboBoxItem Content="Text size" />
                            <ComboBoxItem Content="Font" />
                            <ComboBoxItem Content="Style (bold, italic...)" />
                        </ComboBox>
                        <TextBlock Text="in" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource MutedText}" />
                        <ComboBox x:Name="FindInBox" Width="190" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="OnFindOptionsChanged">
                            <ComboBoxItem Content="Text notes and dimensions" />
                            <ComboBoxItem Content="Text notes only" />
                            <ComboBoxItem Content="Dimensions only" />
                        </ComboBox>
                        <CheckBox x:Name="NotApprovedBox" Content="Only show not approved" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="OnFindOptionsChanged" Unchecked="OnFindOptionsChanged"
                                  ToolTip="Compares against the approved lists in Settings > Text type &amp; size." />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- What is used in the model -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" x:Name="GroupsCaption" Text="Used in the model" Margin="0,0,0,6"
                                       Style="{StaticResource MutedText}" />
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="GroupsGrid" SelectionMode="Single" SelectionChanged="OnGroupSelected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VALUE" Binding="{Binding Label, Mode=OneWay}" Width="*" />
                                        <DataGridTextColumn Header="COUNT" Binding="{Binding Count, Mode=OneWay}" Width="60" />
                                        <DataGridTextColumn Header="STANDARD" Binding="{Binding Standard, Mode=OneWay}" Width="92" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- The elements using the selected value -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" x:Name="ElementsCaption" Text="Select a value on the left to list the text using it."
                                       Margin="0,0,0,6" Style="{StaticResource MutedText}" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SelectGroupButton" Content="Select all in Revit" Click="OnSelectGroup" IsEnabled="False"
                                        Margin="0,0,8,0"
                                        ToolTip="Selects every listed element in Revit, so you can change their type in the Type Selector." />
                                <Button x:Name="ShowElementButton" Content="Show in Revit" Click="OnShowElement" IsEnabled="False"
                                        ToolTip="Opens the view the selected element is in and zooms to it." />
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="ElementsGrid" SelectionMode="Extended"
                                          SelectionChanged="OnElementSelected" MouseDoubleClick="OnElementDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TEXT" Binding="{Binding Text, Mode=OneWay}" Width="220" />
                                        <DataGridTextColumn Header="KIND" Binding="{Binding Kind, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="TYPE" Binding="{Binding TypeName, Mode=OneWay}" Width="170" />
                                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size, Mode=OneWay}" Width="62" />
                                        <DataGridTextColumn Header="FONT" Binding="{Binding Font, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="STYLE" Binding="{Binding Style, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="WHERE" Binding="{Binding Location, Mode=OneWay}" Width="220" />
                                        <DataGridTextColumn Header="ELEMENT ID" Binding="{Binding ElementId, Mode=OneWay}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
