<Window x:Class="RevitTextQC.UI.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text QC" Width="1100" Height="640" MinWidth="760" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">

        <!-- Scan and filter bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ScopeBox" Width="130" Margin="0,0,6,0" SelectedIndex="0">
                <ComboBoxItem Content="Active view / sheet" />
                <ComboBoxItem Content="Entire project" />
            </ComboBox>
            <Button x:Name="ScanButton" Content="Scan" Click="OnScan" FontWeight="SemiBold" />
            <TextBlock Text="Rule:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox x:Name="RuleBox" Width="170" Margin="0,0,6,0" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="6,0,6,0" />
            <TextBox x:Name="SearchBox" Width="170" VerticalContentAlignment="Center" TextChanged="OnFilterChanged" />
            <Button DockPanel.Dock="Right" Content="Settings..." Click="OnSettings" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export CSV..." Click="OnExport" Margin="6,0,0,0" />
        </DockPanel>

        <!-- Status line -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#444" Text="Ready." />

        <!-- Selected finding -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DetailMessage" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Select a finding to see the details." />

                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="Corrected text (edit before applying if needed):" Foreground="#666" />
                    <TextBox x:Name="FixBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" IsEnabled="False" />
                </DockPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Width="230">
                    <TextBlock Text="Spelling suggestions:" Foreground="#666" />
                    <ComboBox x:Name="AlternativesBox" IsEnabled="False" SelectionChanged="OnAlternativeChosen" />
                    <Button x:Name="AddWordButton" Content="Add word to dictionary" Click="OnAddWord"
                            Margin="0,8,0,0" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ShowButton" Content="Show in Revit" Click="OnShow" IsEnabled="False" />
                    <Button x:Name="ApplyButton" Content="Apply fix" Click="OnApply" IsEnabled="False" />
                    <Button x:Name="FixSelectedButton" Content="Fix all selected" Click="OnFixSelected" IsEnabled="False"
                            ToolTip="Applies the first suggestion to every selected finding that has one." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Findings -->
        <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4"
                  AlternatingRowBackground="#FAFAFA" RowHeaderWidth="0" CanUserResizeRows="False"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="62" />
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="110" />
                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="2*" />
                <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="3*" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Source}" Width="100" />
                <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="*" />
                <DataGridTextColumn Header="Fix" Binding="{Binding FixLabel}" Width="44" />
                <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
